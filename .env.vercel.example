# Copy these into Vercel → Project → Settings → Environment Variables
# (Do not put real secrets in git. This file is a template only.)

# ── Minimum (public executive dashboard) ───────────────────────────────
VITE_AUTH_ENABLED=false
SITE_URL=https://dashboard.ascentbuildings.com

# Until custom domain is live, you can use your Vercel URL instead:
# SITE_URL=https://ascent-bookings-dashboard.vercel.app

# ── Optional: shared Postgres (omit for demo — uses PGLite) ────────────
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Optional: auth ON (skip for public review) ─────────────────────────
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_URL=https://dashboard.ascentbuildings.com
# BETTER_AUTH_SECRET=

# ── Optional: Dodge live pipeline ──────────────────────────────────────
# DODGE_API_BASE_URL=
# DODGE_CLIENT_ID=
# DODGE_CLIENT_SECRET=
# DODGE_TOKEN_URL=
# DODGE_ACCESS_TOKEN=
# DODGE_API_KEY=
