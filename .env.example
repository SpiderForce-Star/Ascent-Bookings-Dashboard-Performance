# Optional: Neon Postgres (otherwise PGLite local fallback)
# DATABASE_URL=postgresql://...

# ── Public site / custom domain ──────────────────────────────────────────
# Production custom domain (recommended): dashboard.ascentbuildings.com
SITE_URL=https://dashboard.ascentbuildings.com

# Public executive review (no login wall)
VITE_AUTH_ENABLED=false

# Only if auth is enabled in production:
# BETTER_AUTH_URL=https://dashboard.ascentbuildings.com

# ── Dodge Construction Network API (enterprise) ──────────────────────────
# Request access: https://www.construction.com/apis/
# Without these vars the dashboard serves a demo SE pipeline (not licensed Dodge data).

# API root issued by Dodge (example shape — use the URL they provide)
DODGE_API_BASE_URL=https://api.construction.com/v1

# OAuth 2.0 client credentials (preferred)
DODGE_CLIENT_ID=
DODGE_CLIENT_SECRET=

# Optional override if Dodge gives a dedicated token URL
# DODGE_TOKEN_URL=https://api.construction.com/oauth/token

# Or paste a pre-issued bearer token (skips client_credentials grant)
# DODGE_ACCESS_TOKEN=

# Some tenants also issue a static API key header
# DODGE_API_KEY=
